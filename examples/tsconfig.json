{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": ["node", "vite/client"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./**/*.mts"],
  "exclude": ["dist"]
}
