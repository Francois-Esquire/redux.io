{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "rootDir": "lib",
    "outDir": ".build",
    "types": ["react"],
    "skipLibCheck": false
  },
  "include": ["lib/**/*.ts"]
}
