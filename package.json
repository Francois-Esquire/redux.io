{
  "name": "redux.io",
  "description": "React and Redux bindings for Socket.IO",
  "keywords": [
    "websocket",
    "socket.io",
    "react",
    "redux"
  ],
  "version": "1.0.0",
  "main": "dist/redux.io.js",
  "module": "dist/redux.io.mjs",
  "types": "dist/redux.io.d.ts",
  "scripts": {
    "prepack": "npm run build",
    "hooks:install": "husky",
    "lint:staged": "lint-staged",
    "changelog": "conventional-changelog -p conventionalcommits -c changelog.context.mjs -i CHANGELOG.md -r 0 && prettier --write CHANGELOG.md",
    "prepublishOnly": "npm run check",
    "build": "tsc -p tsconfig.build.json && rollup -c && prettier --write dist",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p examples/tsconfig.json",
    "examples:dev": "npm run build && vite --config examples/vite.config.mts",
    "examples:server": "tsx examples/start.ts",
    "examples:build": "vite build --config examples/vite.config.mts",
    "test": "npm run build && vitest run",
    "cov": "npm run build && vitest run --coverage",
    "lint": "eslint lib tests examples *.mjs",
    "format:check": "prettier --check lib tests examples *.mjs tsconfig.build.json package.json README.md CHANGELOG.md .github/workflows",
    "check": "npm run lint && npm run format:check && npm run cov && npm run typecheck && npm run examples:build && npm run test:package",
    "test:package": "node --test tests/package.test.cjs",
    "watch:test": "npm run build && vitest",
    "watch:build": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@types/hoist-non-react-statics": "^3.3.7",
    "hoist-non-react-statics": "^3.3.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-redux": "^9.0.0",
    "redux": "^5.0.0",
    "socket.io-client": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react-redux": {
      "optional": true
    },
    "redux": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Francois-Esquire/redux.io.git"
  },
  "bugs": {
    "url": "https://github.com/Francois-Esquire/redux.io/issues"
  },
  "homepage": "https://github.com/Francois-Esquire/redux.io#readme",
  "author": "Michael Tobia",
  "license": "MIT",
  "unpkg": "dist/redux.io.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/redux.io.d.mts",
        "default": "./dist/redux.io.mjs"
      },
      "require": {
        "types": "./dist/redux.io.d.ts",
        "default": "./dist/redux.io.js"
      }
    },
    "./source": "./lib/index.ts",
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    },
    "./react/source": "./lib/react.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
